generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RemoteSessionStatus {
  REQUESTED
  APPROVED
  DENIED
  ENDED
}

enum RemoteSessionMode {
  SUPPORT
  GAME
}

enum UserRole {
  OWNER
  ADMIN
  TECHNICIAN
  VIEWER
}

enum CommandExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model Workspace {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  customers Customer[]
}

model User {
  id           String   @id @default(cuid())
  workspaceId  String   @default("ws_default")
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TECHNICIAN)
  active       Boolean  @default(true)
  sessionVersion Int     @default(0)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  remoteSessions    RemoteSession[]
  auditEvents        AuditEvent[]
  commandExecutions CommandExecution[]

  @@index([email])
  @@index([role])
  @@index([workspaceId])
}

model Customer {
  id           String   @id @default(cuid())
  workspaceId  String   @default("ws_default")
  name         String
  document     String
  contactName  String
  contactEmail String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  devices             Device[]
  agentEnrollmentKeys AgentEnrollmentKey[]

  @@index([name])
  @@index([workspaceId])
}

model AgentEnrollmentKey {
  id         String    @id @default(cuid())
  customerId String
  name       String
  keyHash    String    @unique
  boundRemoteId String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([active])
  @@index([boundRemoteId])
}

model Device {
  id           String    @id @default(cuid())
  customerId   String
  displayName  String
  remoteId     String    @unique
  os           String
  userName     String
  localIp      String
  biosSerial   String?
  systemUuid   String?
  primaryMac   String?
  identityHash String?
  tags         String[]  @default([])
  lastSeenAt   DateTime?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer          Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  remoteSessions    RemoteSession[]
  auditEvents        AuditEvent[]
  commandExecutions  CommandExecution[]
  inventorySnapshots InventorySnapshot[]

  @@index([customerId])
  @@index([biosSerial])
  @@index([systemUuid])
  @@index([primaryMac])
  @@index([identityHash])
  @@index([lastSeenAt])
  @@index([archivedAt])
}

model RemoteSession {
  id             String              @id @default(cuid())
  deviceId       String
  userId         String?
  technicianName String
  reason         String
  mode           RemoteSessionMode   @default(SUPPORT)
  monitorIndex   Int?
  status         RemoteSessionStatus @default(REQUESTED)
  connectionTokenHash      String?
  connectionTokenExpiresAt DateTime?
  connectionTokenUsedAt    DateTime?
  requestedAt    DateTime            @default(now())
  endedAt        DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([userId])
  @@index([requestedAt])
  @@index([connectionTokenExpiresAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  action    String
  actor     String
  targetId  String
  deviceId  String?
  userId    String?
  createdAt DateTime @default(now())
  metadata  Json     @default("{}")

  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([targetId])
  @@index([userId])
  @@index([createdAt])
}

model CommandExecution {
  id          String                 @id @default(cuid())
  deviceId    String
  commandType String
  status      CommandExecutionStatus @default(PENDING)
  requestedBy String
  userId      String?
  requestedAt DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  payload     Json                   @default("{}")
  output      Json?
  error       String?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([userId])
  @@index([status])
}

model InventorySnapshot {
  id          String   @id @default(cuid())
  deviceId    String
  hardware    Json
  software    Json
  collectedAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}
