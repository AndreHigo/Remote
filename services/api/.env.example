DATABASE_URL="postgresql://remoto:remoto@localhost:55432/remoto?schema=public"
PORT=4100
WEB_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
JWT_SECRET="change-this-local-secret"
TOTP_ENCRYPTION_KEY="change-this-totp-encryption-key"
REALTIME_INTERNAL_SECRET="change-this-realtime-internal-secret"
ENABLE_GAME_MODE=false
TRUST_PROXY="false"
# Caminho absoluto do instalador Windows publicado pela propria implantacao.
# Sem este arquivo, /downloads/agent retorna 404 e o painel informa a pendencia.
REMOTO_AGENT_INSTALLER_PATH="/opt/remoto/releases/RemotoAgent-Setup.exe"
