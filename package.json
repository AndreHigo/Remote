{
  "name": "remoto",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma online de acesso remoto, suporte tecnico e gestao de dispositivos.",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w services/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w services/api && npm run build -w apps/web && npm run build -w apps/desktop-control && npm run build -w apps/agent && npm run build -w services/realtime && npm run build -w apps/operator",
    "test": "npm run test:security && npm run test -w apps/agent && npm run test -w apps/desktop-control && npm run test -w services/realtime && npm run test -w apps/operator",
    "test:security": "npm run test:security -w services/api",
    "typecheck": "npm run typecheck -w services/api && npm run typecheck -w apps/web && npm run typecheck -w apps/desktop-control && npm run typecheck -w apps/agent && npm run typecheck -w services/realtime",
    "validate:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-local-release.ps1",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d postgres",
    "db:push": "npm run db:push -w services/api",
    "db:seed": "npm run db:seed -w services/api",
    "deploy:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/docker/preflight-production.ps1",
    "backup:rotate": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/docker/rotate-backups.ps1",
    "agent:register": "npm run register -w apps/agent",
    "agent:heartbeat": "npm run heartbeat -w apps/agent",
    "agent:inventory": "npm run inventory -w apps/agent",
    "agent:commands": "npm run commands -w apps/agent",
    "agent:loop": "npm run loop -w apps/agent",
    "agent:sessions": "npm run sessions -w apps/agent",
    "agent:config:init": "npm run config:init -w apps/agent",
    "agent:status": "npm run status -w apps/agent",
    "agent:service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/agent/scripts/install-windows-service.ps1",
    "agent:service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/agent/scripts/install-windows-service.ps1 -Uninstall",
    "agent:package:windows": "npm run package:windows -w apps/agent",
    "operator:dev": "npm run dev -w apps/operator",
    "operator:build": "npm run build -w apps/operator",
    "operator:package:windows": "npm run package:windows -w apps/operator",
    "diagnostics:host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/homologate-host.ps1",
    "local:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-stack.ps1",
    "smoke:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-local.ps1",
    "measure:realtime": "npm exec -- tsx scripts/measure-realtime-session.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
