{
  email {$ACME_EMAIL}
}

{$WEB_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  }

  handle_path /api/* {
    reverse_proxy api:4100
  }

  handle_path /realtime/* {
    reverse_proxy realtime:4200
  }

  handle {
    reverse_proxy web:80
  }
}
