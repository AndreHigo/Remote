# Dominios e TLS
WEB_DOMAIN=remoto.example.com
ACME_EMAIL=admin@example.com

# PostgreSQL interno da stack
POSTGRES_DB=remoto
POSTGRES_USER=remoto
POSTGRES_PASSWORD=troque-por-um-segredo-longo
BACKUP_ENCRYPTION_KEY=troque-por-um-segredo-exclusivo-para-backups-com-32-caracteres

# Segredos da API, nunca reutilize estes valores em producao
JWT_SECRET=troque-por-um-segredo-aleatorio
DESKTOP_SESSION_SECRET=troque-por-um-segredo-exclusivo-de-sessoes-com-32-caracteres
TOTP_ENCRYPTION_KEY=troque-por-outro-segredo-aleatorio
REALTIME_INTERNAL_SECRET=troque-por-um-segredo-exclusivo-do-relay-com-32-caracteres
REALTIME_CONTROL_URL=http://realtime:4200
REALTIME_API_URL=http://api:4100
REALTIME_PORT=4200
REALTIME_ALLOWED_ORIGINS=https://remoto.example.com
ENABLE_GAME_MODE=false

# Primeiro owner criado de forma idempotente no banco vazio
BOOTSTRAP_ADMIN_NAME=Administrador Remoto
BOOTSTRAP_ADMIN_EMAIL=admin@seu-dominio.com
BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-com-12-caracteres-ou-mais

# DNS/IP publico que os clientes RustDesk conseguem resolver
RUSTDESK_RELAY_HOST=remote.example.com
