{
  "name": "@remoto/operator",
  "version": "0.1.0",
  "private": true,
  "author": "Remoto",
  "description": "Janela nativa do operador Remoto para sessoes de jogo.",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "node -e \"const fs=require('fs'); for (const f of ['src/main.cjs','src/preload.cjs','src/renderer.html','src/media.js','src/renderer.js','src/renderer.css']) if (!fs.existsSync(f)) process.exit(1); console.log('Cliente operador nativo pronto para empacotamento.')\"",
    "test": "node --test src/media.test.cjs scripts/package-windows.test.cjs",
    "bundle:transport": "esbuild ../desktop-control/src/operator.ts --bundle --platform=node --format=esm --outfile=build/desktop-control.mjs --external:node:*",
    "package:windows:dir": "npm run bundle:transport && electron-builder --dir",
    "package:windows": "npm run bundle:transport && node scripts/package-windows.cjs"
  },
  "build": {
    "appId": "br.com.remoto.operator",
    "productName": "Remoto",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["src/**/*", "build/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Remoto-Operator-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "fileAssociations": [{
      "ext": "remoto-session",
      "name": "Remoto Session",
      "description": "Sessao de jogo Remoto aprovada",
      "role": "Viewer"
    }]
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  }
}
